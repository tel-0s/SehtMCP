<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SehtMcp</AssemblyName>
    <Version>0.3.0</Version>
    <Description>Skyrim SE plugin authoring and asset inspection over MCP.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
</Project>
